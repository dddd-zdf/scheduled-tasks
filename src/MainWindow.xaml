<Window x:Class="ScheduledTasks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduled Tasks" Width="1250" Height="640" MinWidth="980" MinHeight="420"
        WindowStartupLocation="CenterScreen" FontSize="13" Icon="app.ico">
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="MinWidth" Value="76"/>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="GroupName" Value="Scope"/>
    </Style>
    <Style x:Key="Cell" TargetType="TextBlock">
      <Setter Property="Margin" Value="6,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*" MinWidth="120"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Grid.Column="0">
        <RadioButton Content="My scripts" Tag="mine" IsChecked="True" Checked="OnScope" ToolTip="Tasks that run a script (.ps1, .py, .vbs, .cmd...)"/>
        <RadioButton Content="All apps" Tag="apps" Checked="OnScope" ToolTip="Everything outside Windows' own folder"/>
        <RadioButton Content="Windows" Tag="windows" Checked="OnScope" ToolTip="Windows' built-in tasks"/>
        <TextBlock Text="Filter" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
      <TextBox x:Name="Search" Grid.Column="1" MaxWidth="320" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" TextChanged="OnFilter"/>
      <CheckBox x:Name="OnlyProblems" Grid.Column="2" Content="Only problems" VerticalAlignment="Center" Margin="12,0,16,0" Click="OnFilter"/>
      <StackPanel Orientation="Horizontal" Grid.Column="3">
        <Button Content="Deleted backups" Click="OnBackups" ToolTip="Folder with copies of tasks you deleted"/>
        <Button x:Name="BAdmin" Content="Restart as admin" Click="OnAdmin" ToolTip="Needed to change tasks that run with admin rights"/>
        <Button Content="Refresh" Margin="0" Click="OnRefresh"/>
      </StackPanel>
    </Grid>

    <DataGrid x:Name="TaskGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              RowHeight="34" CanUserResizeRows="False" Background="Transparent" RowBackground="Transparent"
              AlternatingRowBackground="Transparent" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              SelectionChanged="OnSelection">
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding StateKind}" Value="off"><Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/></DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem x:Name="MRun" Header="Run now" Click="OnRun"/>
          <MenuItem x:Name="MStop" Header="Stop" Click="OnStop"/>
          <MenuItem x:Name="MToggle" Header="Turn off" Click="OnToggle"/>
          <MenuItem x:Name="MShow" Header="Show file" Click="OnShow"/>
          <Separator/>
          <MenuItem x:Name="MDelete" Header="Delete..." Click="OnDelete"/>
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource Cell}"/>
        <DataGridTemplateColumn Header="State" SortMemberPath="State" Width="76">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border CornerRadius="9" Padding="9,1" Margin="6,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding StateKind}" Value="off"><Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}"/></DataTrigger>
                      <DataTrigger Binding="{Binding StateKind}" Value="run"><Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding State}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="2*" ElementStyle="{StaticResource Cell}"/>
        <DataGridTextColumn Header="Last run" Binding="{Binding LastText}" SortMemberPath="LastRun" Width="150" ElementStyle="{StaticResource Cell}"/>
        <DataGridTemplateColumn Header="Result" SortMemberPath="Result" Width="1.4*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Result}" Margin="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ResultKind}" Value="ok"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/></DataTrigger>
                      <DataTrigger Binding="{Binding ResultKind}" Value="run"><Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/></DataTrigger>
                      <DataTrigger Binding="{Binding ResultKind}" Value="bad"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Next run" Binding="{Binding NextText}" SortMemberPath="NextRun" Width="150" ElementStyle="{StaticResource Cell}"/>
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,10,0,0">
      <StackPanel>
        <TextBlock x:Name="DName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="Pick a task"/>
        <TextBlock x:Name="DDesc" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
        <TextBlock x:Name="DCmd" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,6,0,10"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BRun" Content="Run now" Click="OnRun"/>
          <Button x:Name="BStop" Content="Stop" Click="OnStop"/>
          <Button x:Name="BToggle" Content="Turn off" Click="OnToggle"/>
          <Button x:Name="BShow" Content="Show file" Click="OnShow"/>
          <Button x:Name="BDelete" Content="Delete..." Click="OnDelete" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="18,0,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock x:Name="Status" Grid.Row="3" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2,8,0,0"/>
  </Grid>
</Window>
