<Window x:Class="ScheduledTasks.WatchListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit watch list" Width="780" Height="560" MinWidth="480" MinHeight="350"
        WindowStartupLocation="CenterOwner" FontSize="13" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <Label Content="_Filter tasks" Target="{Binding ElementName=Filter}" VerticalAlignment="Center" Padding="0,0,10,0"/>
      <TextBox x:Name="Filter" VerticalContentAlignment="Center" TextChanged="OnFilter"/>
    </DockPanel>

    <DataGrid Grid.Row="1" x:Name="TaskChoices" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" SelectionMode="Single" RowHeight="32" CanUserResizeRows="False"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              Background="Transparent" RowBackground="Transparent"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <DataGrid.Resources>
        <Style x:Key="TaskCell" TargetType="TextBlock">
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="Margin" Value="6,0"/>
          <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
          <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Watch" Width="78" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding Watched, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{Binding Key}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Task" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource TaskCell}"/>
        <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*" ElementStyle="{StaticResource TaskCell}"/>
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Save" IsDefault="True" Click="OnSave" MinWidth="76" Margin="0,0,8,0"/>
      <Button Content="Cancel" IsCancel="True" MinWidth="76"/>
    </StackPanel>
  </Grid>
</Window>
